              "raw": "{\n  \"firstName\": \"Almaz\",\n  \"lastName\": \"Kebede\",\n  \"username\": \"almazk\",\n  \"password\": \"SecurePass1\",\n  \"phone\": \"0911223344\",\n  \"role\": \"weaver\"\n}"
