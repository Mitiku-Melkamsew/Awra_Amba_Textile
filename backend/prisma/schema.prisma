generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  admin
  weaver
  merchant
}

enum WorkOrderStatus {
  assigned
  in_progress
  returned
  reconciled
  cancelled
}

enum SettlementStatus {
  draft
  paid
  cancelled
}

enum DirectTxnType {
  fabric_purchase_from_weaver
  yarn_sale_to_weaver
  fabric_sale_to_merchant
}

enum DirectTxnStatus {
  unpaid
  partially_paid
  paid
  cancelled
}

enum SettlementBatchStatus {
  draft
  committed
}

// ==========================================
// USERS & ROLES
// ==========================================

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  username     String   @unique @db.VarChar(60)
  fullName     String   @map("full_name") @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(120)
  passwordHash String?  @map("password_hash") @db.VarChar(200)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles                         UserRoleAssignment[]
  workOrdersAssigned            WorkOrder[]                @relation("WeaverWorkOrders")
  workOrdersIssued              WorkOrder[]                @relation("WorkOrderIssuer")
  yarnGivenRecorded             YarnGiven[]                @relation("YarnGivenRecorder")
  yarnReturnsRecorded           YarnReturn[]               @relation("YarnReturnRecorder")
  fabricReturnsRecorded         FabricReturn[]             @relation("FabricReturnRecorder")
  fabricReturnsToWeaverRecorded FabricReturnToWeaver[]     @relation("FabricReturnToWeaverRecorder")
  yarnPurchasesCreated          YarnPurchase[]             @relation("YarnPurchaseCreator")
  settlementsAsWeaver           Settlement[]               @relation("WeaverSettlements")
  settlementsCreated            Settlement[]               @relation("SettlementCreator")
  settlementBatchesCreated     SettlementBatch[]          @relation("SettlementBatchCreator")
  settlementPaymentsRecorded    SettlementPayment[]        @relation("SettlementPaymentRecorder")
  directTxnsAsWeaver            DirectTransaction[]        @relation("WeaverDirectTxns")
  directTxnsAsMerchant          DirectTransaction[]        @relation("MerchantDirectTxns")
  directTxnsCreated             DirectTransaction[]        @relation("DirectTxnCreator")
  directTxnPaymentsRecorded     DirectTransactionPayment[] @relation("DirectTxnPaymentRecorder")
  auditLogs                     AuditLog[]                 @relation("AuditActor")

  @@map("users")
}

model UserRoleAssignment {
  userId Int      @map("user_id")
  role   UserRole

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// ==========================================
// CATALOG
// ==========================================

model Fabric {
  fabricId         Int      @id @default(autoincrement()) @map("fabric_id")
  name             String   @unique @db.VarChar(120)
  standardLengthCm Decimal  @map("standard_length_cm") @db.Decimal(10, 2)
  standardWidthCm  Decimal  @map("standard_width_cm") @db.Decimal(10, 2)
  standardWeightG  Decimal  @map("standard_weight_g") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variants        FabricVariant[]
  prices          FabricPrice[]
  settlementLines SettlementLine[]

  @@map("fabrics")
}

model Color {
  colorId            Int             @id @default(autoincrement()) @map("color_id")
  name               String          @unique @db.VarChar(80)
  warpFabricVariants FabricVariant[] @relation("WarpColor")
  weftFabricVariants FabricVariant[] @relation("WeftColor")
  yarnVariants       YarnVariant[]

  @@map("colors")
}

model Design {
  designId       Int             @id @default(autoincrement()) @map("design_id")
  name           String          @unique @db.VarChar(120)
  fabricVariants FabricVariant[]

  @@map("designs")
}

model Supplier {
  supplierId   Int      @id @default(autoincrement()) @map("supplier_id")
  name         String   @unique @db.VarChar(120)
  contactPhone String?  @map("contact_phone") @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")

  yarnVariants  YarnVariant[]
  yarnPurchases YarnPurchase[]
  yarnPrices    YarnPrice[]

  @@map("suppliers")
}

model Yarn {
  yarnId   Int     @id @default(autoincrement()) @map("yarn_id")
  name     String  @unique @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")

  yarnVariants YarnVariant[]
  yarnPrices   YarnPrice[]

  @@map("yarns")
}

model FabricVariant {
  fabricVariantId Int     @id @default(autoincrement()) @map("fabric_variant_id")
  fabricId        Int     @map("fabric_id")
  designId        Int     @map("design_id")
  warpColorId     Int     @map("warp_color_id")
  weftColorId     Int     @map("weft_color_id")
  sku             String  @unique @db.VarChar(40)
  stockSnapshot   Decimal @default(0) @map("stock_snapshot") @db.Decimal(12, 2)
  isActive        Boolean @default(true) @map("is_active")

  fabric                 Fabric                 @relation(fields: [fabricId], references: [fabricId])
  design                 Design                 @relation(fields: [designId], references: [designId])
  warpColor              Color                  @relation("WarpColor", fields: [warpColorId], references: [colorId])
  weftColor              Color                  @relation("WeftColor", fields: [weftColorId], references: [colorId])
  workOrders             WorkOrder[]
  fabricReturns          FabricReturn[]
  fabricReturnsToWeaver FabricReturnToWeaver[]
  directTxnLines         DirectTransactionLine[]

  @@map("fabric_variants")
}

model YarnVariant {
  yarnVariantId Int     @id @default(autoincrement()) @map("yarn_variant_id")
  yarnId        Int     @map("yarn_id")
  colorId       Int     @map("color_id")
  supplierId    Int     @map("supplier_id")
  sku           String  @unique @db.VarChar(40)
  stockSnapshot Decimal @default(0) @map("stock_snapshot") @db.Decimal(12, 2)
  isActive      Boolean @default(true) @map("is_active")

  yarn                Yarn                  @relation(fields: [yarnId], references: [yarnId])
  color               Color                 @relation(fields: [colorId], references: [colorId])
  supplier            Supplier              @relation(fields: [supplierId], references: [supplierId])
  purchaseLines       YarnPurchaseLine[]
  yarnGiven           YarnGiven[]
  yarnReturns         YarnReturn[]
  settlementYarnLines SettlementYarnLine[]
  directTxnLines      DirectTransactionLine[]

  @@map("yarn_variants")
}

model FabricPrice {
  fabricPriceId Int       @id @default(autoincrement()) @map("fabric_price_id")
  fabricId      Int       @map("fabric_id")
  weaverRate    Decimal   @map("weaver_rate") @db.Decimal(12, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  fabric Fabric @relation(fields: [fabricId], references: [fabricId])

  @@map("fabric_prices")
}

model YarnPrice {
  yarnPriceId   Int       @id @default(autoincrement()) @map("yarn_price_id")
  yarnId        Int       @map("yarn_id")
  supplierId    Int       @map("supplier_id")
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  yarn     Yarn     @relation(fields: [yarnId], references: [yarnId])
  supplier Supplier @relation(fields: [supplierId], references: [supplierId])

  @@map("yarn_prices")
}

model QualityRule {
  qualityRuleId    Int     @id @default(autoincrement()) @map("quality_rule_id")
  factor           String  @db.VarChar(30)
  unit             String  @db.VarChar(20)
  deductionPerUnit Decimal @map("deduction_per_unit") @db.Decimal(10, 2)
  isActive         Boolean @default(true) @map("is_active")

  @@map("quality_rules")
}

// ==========================================
// PRODUCTION
// ==========================================

model WorkOrder {
  zigId           String          @id @map("zig_id") @db.VarChar(20)
  weaverUserId    Int             @map("weaver_user_id")
  fabricVariantId Int             @map("fabric_variant_id")
  status          WorkOrderStatus @default(assigned)
  dateIssued      DateTime        @default(now()) @map("date_issued") @db.Timestamptz
  issuedByUserId  Int             @map("issued_by_user_id")

  weaver                User                   @relation("WeaverWorkOrders", fields: [weaverUserId], references: [userId])
  fabricVariant         FabricVariant          @relation(fields: [fabricVariantId], references: [fabricVariantId])
  issuedBy              User                   @relation("WorkOrderIssuer", fields: [issuedByUserId], references: [userId])
  yarnGiven             YarnGiven[]
  yarnReturns           YarnReturn[]
  fabricReturns         FabricReturn[]
  fabricReturnsToWeaver FabricReturnToWeaver[]
  settlementLines       SettlementLine[]
  settlementYarnLines   SettlementYarnLine[]

  @@map("work_orders")
}

model YarnGiven {
  yarnGivenId      Int      @id @default(autoincrement()) @map("yarn_given_id")
  zigId            String   @map("zig_id") @db.VarChar(20)
  yarnVariantId    Int      @map("yarn_variant_id")
  quantity         Decimal  @db.Decimal(10, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  dateGiven        DateTime @default(now()) @map("date_given") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")

  workOrder           WorkOrder            @relation(fields: [zigId], references: [zigId])
  yarnVariant         YarnVariant          @relation(fields: [yarnVariantId], references: [yarnVariantId])
  recordedBy          User                 @relation("YarnGivenRecorder", fields: [recordedByUserId], references: [userId])
  settlementYarnLines SettlementYarnLine[]

  @@map("yarn_given")
}

model YarnReturn {
  yarnReturnId     Int      @id @default(autoincrement()) @map("yarn_return_id")
  zigId            String   @map("zig_id") @db.VarChar(20)
  yarnVariantId    Int      @map("yarn_variant_id")
  quantity         Decimal  @db.Decimal(10, 2)
  dateReturned     DateTime @default(now()) @map("date_returned") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  remark           String?

  workOrder   WorkOrder   @relation(fields: [zigId], references: [zigId])
  yarnVariant YarnVariant @relation(fields: [yarnVariantId], references: [yarnVariantId])
  recordedBy  User        @relation("YarnReturnRecorder", fields: [recordedByUserId], references: [userId])

  @@map("yarn_returns")
}

model FabricReturn {
  returnId         Int      @id @default(autoincrement()) @map("return_id")
  zigId            String   @map("zig_id") @db.VarChar(20)
  fabricVariantId  Int      @map("fabric_variant_id")
  quantityReturned Int      @map("quantity_returned")
  totalWeight      Decimal  @map("total_weight") @db.Decimal(10, 2)
  lengthCm         Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm          Decimal? @map("width_cm") @db.Decimal(10, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  dateReturned     DateTime @default(now()) @map("date_returned") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  remark           String?

  workOrder             WorkOrder              @relation(fields: [zigId], references: [zigId])
  fabricVariant         FabricVariant          @relation(fields: [fabricVariantId], references: [fabricVariantId])
  recordedBy            User                   @relation("FabricReturnRecorder", fields: [recordedByUserId], references: [userId])
  settlementLineReturns SettlementLineReturn[]

  @@map("fabric_returns")
}

model FabricReturnToWeaver {
  fabricReturnToWeaverId Int      @id @default(autoincrement()) @map("fabric_return_to_weaver_id")
  zigId                  String   @map("zig_id") @db.VarChar(20)
  fabricVariantId        Int      @map("fabric_variant_id")
  quantity               Int
  dateReturned           DateTime @default(now()) @map("date_returned") @db.Timestamptz
  recordedByUserId       Int      @map("recorded_by_user_id")
  remark                 String?

  workOrder     WorkOrder     @relation(fields: [zigId], references: [zigId])
  fabricVariant FabricVariant @relation(fields: [fabricVariantId], references: [fabricVariantId])
  recordedBy    User          @relation("FabricReturnToWeaverRecorder", fields: [recordedByUserId], references: [userId])

  @@map("fabric_returns_to_weavers")
}

// ==========================================
// PROCUREMENT
// ==========================================

model YarnPurchase {
  purchaseId      Int      @id @default(autoincrement()) @map("purchase_id")
  supplierId      Int      @map("supplier_id")
  purchaseDate    DateTime @default(now()) @map("purchase_date") @db.Timestamptz
  createdByUserId Int      @map("created_by_user_id")
  notes           String?

  supplier  Supplier           @relation(fields: [supplierId], references: [supplierId])
  createdBy User               @relation("YarnPurchaseCreator", fields: [createdByUserId], references: [userId])
  lines     YarnPurchaseLine[]

  @@map("yarn_purchases")
}

model YarnPurchaseLine {
  lineId        Int     @id @default(autoincrement()) @map("line_id")
  purchaseId    Int     @map("purchase_id")
  yarnVariantId Int     @map("yarn_variant_id")
  quantity      Decimal @db.Decimal(10, 2)
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)

  purchase    YarnPurchase @relation(fields: [purchaseId], references: [purchaseId])
  yarnVariant YarnVariant  @relation(fields: [yarnVariantId], references: [yarnVariantId])

  @@map("yarn_purchase_lines")
}

// ==========================================
// SETTLEMENTS
// ==========================================

model Settlement {
  settlementId     Int              @id @default(autoincrement()) @map("settlement_id")
  batchId          Int              @map("batch_id")
  weaverUserId     Int              @map("weaver_user_id")
  status           SettlementStatus @default(draft)
  grossFabricValue Decimal          @map("gross_fabric_value") @db.Decimal(12, 2)
  totalDeductions  Decimal          @map("total_deductions") @db.Decimal(12, 2)
  totalYarnCost    Decimal          @map("total_yarn_cost") @db.Decimal(12, 2)
  netAmount        Decimal          @map("net_amount") @db.Decimal(12, 2)
  createdByUserId  Int              @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  paidAt           DateTime?        @map("paid_at") @db.Timestamptz
  notes            String?

  batch     SettlementBatch      @relation(fields: [batchId], references: [batchId])
  weaver    User                 @relation("WeaverSettlements", fields: [weaverUserId], references: [userId])
  createdBy User                 @relation("SettlementCreator", fields: [createdByUserId], references: [userId])
  lines     SettlementLine[]
  yarnLines SettlementYarnLine[]
  payments  SettlementPayment[]

  @@map("settlements")
}

model SettlementBatch {
  batchId         Int                  @id @default(autoincrement()) @map("batch_id")
  status          SettlementBatchStatus @default(draft)
  snapshot        Json
  totalAmount     Decimal              @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal              @default(0) @map("amount_paid") @db.Decimal(14, 2)
  createdByUserId Int                  @map("created_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  committedAt     DateTime?            @map("committed_at") @db.Timestamptz

  createdBy   User         @relation("SettlementBatchCreator", fields: [createdByUserId], references: [userId])
  settlements Settlement[]

  @@map("settlement_batches")
}

model SettlementLine {
  settlementLineId  Int      @id @default(autoincrement()) @map("settlement_line_id")
  settlementId      Int      @map("settlement_id")
  zigId             String   @map("zig_id") @db.VarChar(20)
  fabricId          Int      @map("fabric_id")
  totalQuantity     Int      @map("total_quantity")
  totalWeight       Decimal  @map("total_weight") @db.Decimal(10, 2)
  averageWeight     Decimal  @map("average_weight") @db.Decimal(10, 2)
  standardWeightG   Decimal  @map("standard_weight_g") @db.Decimal(10, 2)
  standardLengthCm  Decimal? @map("standard_length_cm") @db.Decimal(10, 2)
  standardWidthCm   Decimal? @map("standard_width_cm") @db.Decimal(10, 2)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  deductionFactor   String   @map("deduction_factor") @db.VarChar(30)
  deductionUnit     String   @map("deduction_unit") @db.VarChar(20)
  deductionPerPiece Decimal  @map("deduction_per_piece") @db.Decimal(12, 2)
  deductionAmount   Decimal  @map("deduction_amount") @db.Decimal(12, 2)
  grossFabricValue  Decimal  @map("gross_fabric_value") @db.Decimal(12, 2)
  netFabricValue    Decimal  @map("net_fabric_value") @db.Decimal(12, 2)

  settlement Settlement             @relation(fields: [settlementId], references: [settlementId])
  workOrder  WorkOrder              @relation(fields: [zigId], references: [zigId])
  fabric     Fabric                 @relation(fields: [fabricId], references: [fabricId])
  returns    SettlementLineReturn[]

  @@map("settlement_lines")
}

model SettlementLineReturn {
  settlementLineId Int @map("settlement_line_id")
  returnId         Int @unique @map("return_id")

  settlementLine SettlementLine @relation(fields: [settlementLineId], references: [settlementLineId], onDelete: Cascade)
  fabricReturn   FabricReturn   @relation(fields: [returnId], references: [returnId])

  @@id([settlementLineId, returnId])
  @@map("settlement_line_returns")
}

model SettlementYarnLine {
  settlementYarnLineId Int     @id @default(autoincrement()) @map("settlement_yarn_line_id")
  settlementId         Int     @map("settlement_id")
  zigId                String  @map("zig_id") @db.VarChar(20)
  yarnGivenId          Int     @map("yarn_given_id")
  yarnVariantId        Int     @map("yarn_variant_id")
  issuedQuantity       Decimal @map("issued_quantity") @db.Decimal(10, 2)
  returnedQuantity     Decimal @default(0) @map("returned_quantity") @db.Decimal(10, 2)
  netQuantity          Decimal @map("net_quantity") @db.Decimal(10, 2)
  unitPrice            Decimal @map("unit_price") @db.Decimal(12, 2)
  totalCost            Decimal @map("total_cost") @db.Decimal(12, 2)

  settlement  Settlement  @relation(fields: [settlementId], references: [settlementId])
  workOrder   WorkOrder   @relation(fields: [zigId], references: [zigId])
  yarnGiven   YarnGiven   @relation(fields: [yarnGivenId], references: [yarnGivenId])
  yarnVariant YarnVariant @relation(fields: [yarnVariantId], references: [yarnVariantId])

  @@map("settlement_yarn_lines")
}

model SettlementPayment {
  settlementPaymentId Int      @id @default(autoincrement()) @map("settlement_payment_id")
  settlementId        Int      @map("settlement_id")
  amount              Decimal  @db.Decimal(12, 2)
  paymentMethod       String?  @map("payment_method") @db.VarChar(30)
  paymentDate         DateTime @default(now()) @map("payment_date") @db.Timestamptz
  recordedByUserId    Int      @map("recorded_by_user_id")
  notes               String?

  settlement Settlement @relation(fields: [settlementId], references: [settlementId])
  recordedBy User       @relation("SettlementPaymentRecorder", fields: [recordedByUserId], references: [userId])

  @@map("settlement_payments")
}

// ==========================================
// DIRECT TRANSACTIONS
// ==========================================

model DirectTransaction {
  transactionId   Int             @id @default(autoincrement()) @map("transaction_id")
  type            DirectTxnType
  weaverUserId    Int?            @map("weaver_user_id")
  merchantUserId  Int?            @map("merchant_user_id")
  totalAmount     Decimal         @map("total_amount") @db.Decimal(14, 2)
  amountPaid      Decimal         @default(0) @map("amount_paid") @db.Decimal(14, 2)
  status          DirectTxnStatus @default(unpaid)
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Timestamptz
  createdByUserId Int             @map("created_by_user_id")
  notes           String?

  weaver   User?                      @relation("WeaverDirectTxns", fields: [weaverUserId], references: [userId])
  merchant User?                      @relation("MerchantDirectTxns", fields: [merchantUserId], references: [userId])
  createdBy User                      @relation("DirectTxnCreator", fields: [createdByUserId], references: [userId])
  lines    DirectTransactionLine[]
  payments DirectTransactionPayment[]

  @@map("direct_transactions")
}

model DirectTransactionLine {
  lineId          Int     @id @default(autoincrement()) @map("line_id")
  transactionId   Int     @map("transaction_id")
  fabricVariantId Int?    @map("fabric_variant_id")
  yarnVariantId   Int?    @map("yarn_variant_id")
  quantity        Decimal @db.Decimal(10, 2)
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  description     String? @db.VarChar(200)

  transaction   DirectTransaction @relation(fields: [transactionId], references: [transactionId])
  fabricVariant FabricVariant?    @relation(fields: [fabricVariantId], references: [fabricVariantId])
  yarnVariant   YarnVariant?      @relation(fields: [yarnVariantId], references: [yarnVariantId])

  @@map("direct_transaction_lines")
}

model DirectTransactionPayment {
  paymentId        Int      @id @default(autoincrement()) @map("payment_id")
  transactionId    Int      @map("transaction_id")
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String?  @map("payment_method") @db.VarChar(30)
  paymentDate      DateTime @default(now()) @map("payment_date") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  notes            String?

  transaction DirectTransaction @relation(fields: [transactionId], references: [transactionId])
  recordedBy  User              @relation("DirectTxnPaymentRecorder", fields: [recordedByUserId], references: [userId])

  @@map("direct_transaction_payments")
}

model AuditLog {
  auditLogId  Int      @id @default(autoincrement()) @map("audit_log_id")
  actorUserId Int      @map("actor_user_id")
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(80)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation("AuditActor", fields: [actorUserId], references: [userId])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
