generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  yarn
  fabric
  garment
}

enum UserRole {
  admin
  weaver
  merchant
}

enum WorkOrderStatus {
  assigned
  in_progress
  returned
  reconciled
}

enum SaleMovementType {
  merchant_fabric_sale
  weaver_yarn_sale
  weaver_fabric_purchase
  adjustment
}

enum CommercialTxnType {
  yarn_purchase
  fabric_purchase
  yarn_sale
  fabric_sale
  weaver_payout
}

enum CommercialTxnStatus {
  pending
  in_progress
  awaiting_delivery
  awaiting_payment
  completed
  cancelled
}

enum PaymentTerms {
  prepaid
  on_delivery
  installment
}

enum SettlementPreviewStatus {
  draft
  committed
}

// --- Catalog ---

model Product {
  productId          Int             @id @default(autoincrement()) @map("product_id")
  name               String          @db.VarChar(120)
  category           ProductCategory
  basePrice          Decimal         @map("base_price") @db.Decimal(12, 2)
  standardLengthCm   Decimal?        @map("standard_length_cm") @db.Decimal(10, 2)
  standardWidthCm    Decimal?        @map("standard_width_cm") @db.Decimal(10, 2)
  isActive           Boolean         @default(true) @map("is_active")
  fabricVariants     FabricVariant[]

  @@map("products")
}

model Color {
  colorId    Int    @id @default(autoincrement()) @map("color_id")
  colorCode  String @unique @map("color_code") @db.VarChar(10)
  name       String @unique @db.VarChar(80)
  warpFabricVariants FabricVariant[] @relation("WarpColor")
  weftFabricVariants FabricVariant[] @relation("WeftColor")
  yarnVariants YarnVariant[]

  @@map("colors")
}

model Design {
  designId Int    @id @default(autoincrement()) @map("design_id")
  name     String @unique @db.VarChar(120)
  fabricVariants FabricVariant[]

  @@map("designs")
}

model Supplier {
  supplierId   Int    @id @default(autoincrement()) @map("supplier_id")
  name         String @unique @db.VarChar(120)
  contactPhone String? @map("contact_phone") @db.VarChar(30)
  isActive     Boolean @default(true) @map("is_active")
  yarnVariants YarnVariant[]
  yarnPurchases YarnPurchase[]
  supplierPayments SupplierPayment[]
  commercialTransactions CommercialTransaction[]

  @@map("suppliers")
}

model YarnType {
  yarnTypeId   Int    @id @default(autoincrement()) @map("yarn_type_id")
  materialName String @unique @map("material_name") @db.VarChar(80)
  yarnVariants YarnVariant[]

  @@map("yarn_types")
}

// --- Variants ---

model FabricVariant {
  fabricVariantId Int     @id @default(autoincrement()) @map("fabric_variant_id")
  productId       Int     @map("product_id")
  designId        Int?    @map("design_id")
  warpColorId     Int     @map("warp_color_id")
  weftColorId     Int     @map("weft_color_id")
  basePrice       Decimal? @map("base_price") @db.Decimal(12, 2)
  sku             String  @unique @db.VarChar(40)
  stockSnapshot   Decimal @default(0) @map("stock_snapshot") @db.Decimal(12, 2)
  isActive        Boolean @default(true) @map("is_active")

  product    Product  @relation(fields: [productId], references: [productId])
  design     Design?  @relation(fields: [designId], references: [designId])
  warpColor  Color    @relation("WarpColor", fields: [warpColorId], references: [colorId])
  weftColor  Color    @relation("WeftColor", fields: [weftColorId], references: [colorId])
  workOrders WorkOrder[]
  fabricReturns FabricReturn[]
  sales      Sale[]
  commercialLines CommercialTransactionLine[]
  qualityRule QualityRule?
  bonusRule   BonusRule?

  @@map("fabric_variants")
}

model YarnVariant {
  yarnVariantId Int     @id @default(autoincrement()) @map("yarn_variant_id")
  yarnTypeId    Int     @map("yarn_type_id")
  colorId       Int     @map("color_id")
  supplierId    Int     @map("supplier_id")
  basePrice     Decimal? @map("base_price") @db.Decimal(12, 2)
  sku           String  @unique @db.VarChar(40)
  stockSnapshot Decimal @default(0) @map("stock_snapshot") @db.Decimal(12, 2)
  isActive      Boolean @default(true) @map("is_active")

  yarnType  YarnType @relation(fields: [yarnTypeId], references: [yarnTypeId])
  color     Color    @relation(fields: [colorId], references: [colorId])
  supplier  Supplier @relation(fields: [supplierId], references: [supplierId])
  purchaseLines YarnPurchaseLine[]
  yarnGiven YarnGiven[]
  sales     Sale[]
  commercialLines CommercialTransactionLine[]

  @@map("yarn_variants")
}

// --- Calculation rules (improvement over hardcoded Python) ---

model QualityRule {
  qualityRuleId       Int     @id @default(autoincrement()) @map("quality_rule_id")
  fabricVariantId     Int     @unique @map("fabric_variant_id")
  minWeightThreshold  Decimal @map("min_weight_threshold") @db.Decimal(10, 2)
  deductionRatePerUnit Decimal @default(10) @map("deduction_rate_per_unit") @db.Decimal(10, 2)
  isActive            Boolean @default(true) @map("is_active")

  fabricVariant FabricVariant @relation(fields: [fabricVariantId], references: [fabricVariantId])

  @@map("quality_rules")
}

model BonusRule {
  bonusRuleId        Int     @id @default(autoincrement()) @map("bonus_rule_id")
  fabricVariantId    Int     @unique @map("fabric_variant_id")
  minWeightThreshold Decimal @map("min_weight_threshold") @db.Decimal(10, 2)
  bonusRatePerUnit   Decimal @default(10) @map("bonus_rate_per_unit") @db.Decimal(10, 2)
  maxBonusPerPiece   Decimal? @map("max_bonus_per_piece") @db.Decimal(12, 2)
  isActive           Boolean @default(true) @map("is_active")

  fabricVariant FabricVariant @relation(fields: [fabricVariantId], references: [fabricVariantId])

  @@map("bonus_rules")
}

// --- Auth & Actors ---

model Weaver {
  weaverId          Int     @id @default(autoincrement()) @map("weaver_id")
  firstName         String  @map("first_name") @db.VarChar(80)
  lastName          String  @map("last_name") @db.VarChar(80)
  phone             String? @db.VarChar(30)
  email             String? @db.VarChar(120)
  bankAccountNumber String? @map("bank_account_number") @db.VarChar(40)
  isActive          Boolean @default(true) @map("is_active")

  user       User?
  workOrders WorkOrder[]
  sales      Sale[]
  payments   Payment[]
  commercialTransactions CommercialTransaction[]

  @@map("weavers")
}

model Merchant {
  merchantId   Int     @id @default(autoincrement()) @map("merchant_id")
  companyName  String? @map("company_name") @db.VarChar(120)
  contactPhone String  @map("contact_phone") @db.VarChar(30)
  contactEmail String? @map("contact_email") @db.VarChar(120)
  isActive     Boolean @default(true) @map("is_active")

  user             User?
  sales            Sale[]
  merchantPayments MerchantPayment[]
  commercialTransactions CommercialTransaction[]

  @@map("merchants")
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  username     String   @unique @db.VarChar(60)
  passwordHash String?  @map("password_hash") @db.VarChar(200)
  role         UserRole
  weaverId     Int?     @unique @map("weaver_id")
  merchantId   Int?     @unique @map("merchant_id")
  isActive     Boolean  @default(true) @map("is_active")

  weaver   Weaver?   @relation(fields: [weaverId], references: [weaverId], onDelete: SetNull)
  merchant Merchant? @relation(fields: [merchantId], references: [merchantId], onDelete: SetNull)

  yarnPurchasesCreated     YarnPurchase[]     @relation("YarnPurchaseCreator")
  supplierPaymentsRecorded SupplierPayment[]  @relation("SupplierPaymentRecorder")
  workOrdersIssued         WorkOrder[]        @relation("WorkOrderIssuer")
  yarnGivenRecorded        YarnGiven[]        @relation("YarnGivenRecorder")
  fabricReturnsRecorded    FabricReturn[]     @relation("FabricReturnRecorder")
  salesRecorded            Sale[]             @relation("SaleRecorder")
  paymentsRecorded         Payment[]          @relation("PaymentRecorder")
  merchantPaymentsRecorded MerchantPayment[]  @relation("MerchantPaymentRecorder")
  commercialTransactionsCreated CommercialTransaction[] @relation("CommercialTxnCreator")
  commercialTxnPaymentsRecorded CommercialTransactionPayment[] @relation("CommercialTxnPaymentRecorder")
  settlementPreviewsCreated SettlementPreview[] @relation("SettlementPreviewCreator")

  @@map("users")
}

// --- Procurement ---

model YarnPurchase {
  purchaseId       Int      @id @default(autoincrement()) @map("purchase_id")
  supplierId       Int      @map("supplier_id")
  purchaseDate     DateTime @default(now()) @map("purchase_date") @db.Timestamptz
  createdByUserId  Int      @map("created_by_user_id")
  notes            String?

  supplier  Supplier @relation(fields: [supplierId], references: [supplierId])
  createdBy User     @relation("YarnPurchaseCreator", fields: [createdByUserId], references: [userId])
  lines     YarnPurchaseLine[]

  @@map("yarn_purchases")
}

model YarnPurchaseLine {
  lineId         Int     @id @default(autoincrement()) @map("line_id")
  purchaseId     Int     @map("purchase_id")
  yarnVariantId  Int     @map("yarn_variant_id")
  quantity       Decimal @db.Decimal(10, 2)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)

  purchase    YarnPurchase @relation(fields: [purchaseId], references: [purchaseId])
  yarnVariant YarnVariant  @relation(fields: [yarnVariantId], references: [yarnVariantId])

  @@map("yarn_purchase_lines")
}

model SupplierPayment {
  paymentId          Int      @id @default(autoincrement()) @map("payment_id")
  supplierId         Int      @map("supplier_id")
  amount             Decimal  @db.Decimal(12, 2)
  paymentMethod      String?  @map("payment_method") @db.VarChar(30)
  paymentDate        DateTime @default(now()) @map("payment_date") @db.Timestamptz
  recordedByUserId   Int      @map("recorded_by_user_id")
  notes              String?

  supplier   Supplier @relation(fields: [supplierId], references: [supplierId])
  recordedBy User     @relation("SupplierPaymentRecorder", fields: [recordedByUserId], references: [userId])

  @@map("supplier_payments")
}

// --- Production ---

model WorkOrder {
  zigId            String          @id @map("zig_id") @db.VarChar(20)
  weaverId         Int             @map("weaver_id")
  fabricVariantId  Int             @map("fabric_variant_id")
  status           WorkOrderStatus @default(assigned)
  dateIssued       DateTime        @default(now()) @map("date_issued") @db.Timestamptz
  issuedByUserId   Int             @map("issued_by_user_id")

  weaver        Weaver        @relation(fields: [weaverId], references: [weaverId])
  fabricVariant FabricVariant @relation(fields: [fabricVariantId], references: [fabricVariantId])
  issuedBy      User          @relation("WorkOrderIssuer", fields: [issuedByUserId], references: [userId])
  yarnGiven     YarnGiven[]
  fabricReturns FabricReturn[]

  @@map("work_orders")
}

model YarnGiven {
  yarnGivenId      Int      @id @default(autoincrement()) @map("yarn_given_id")
  zigId            String   @map("zig_id") @db.VarChar(20)
  yarnVariantId    Int      @map("yarn_variant_id")
  quantity         Decimal  @db.Decimal(10, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  dateGiven        DateTime @default(now()) @map("date_given") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  paymentId        Int?     @map("payment_id")

  workOrder   WorkOrder   @relation(fields: [zigId], references: [zigId])
  yarnVariant YarnVariant @relation(fields: [yarnVariantId], references: [yarnVariantId])
  recordedBy  User        @relation("YarnGivenRecorder", fields: [recordedByUserId], references: [userId])
  payment     Payment?    @relation(fields: [paymentId], references: [paymentId])

  @@map("yarn_given")
}

model FabricReturn {
  returnId           Int      @id @default(autoincrement()) @map("return_id")
  zigId              String   @map("zig_id") @db.VarChar(20)
  fabricVariantId    Int      @map("fabric_variant_id")
  quantityReturned   Int      @map("quantity_returned")
  totalWeight        Decimal  @map("total_weight") @db.Decimal(10, 2)
  lengthCm           Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm            Decimal? @map("width_cm") @db.Decimal(10, 2)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  dateReturned       DateTime @default(now()) @map("date_returned") @db.Timestamptz
  recordedByUserId   Int      @map("recorded_by_user_id")
  calculatedDeduction Decimal? @map("calculated_deduction") @db.Decimal(12, 2)
  bonusAmount        Decimal  @default(0) @map("bonus_amount") @db.Decimal(12, 2)
  netCreditValue     Decimal? @map("net_credit_value") @db.Decimal(12, 2)
  remark             String?
  paymentId          Int?     @map("payment_id")

  workOrder     WorkOrder     @relation(fields: [zigId], references: [zigId])
  fabricVariant FabricVariant @relation(fields: [fabricVariantId], references: [fabricVariantId])
  recordedBy    User          @relation("FabricReturnRecorder", fields: [recordedByUserId], references: [userId])
  payment       Payment?      @relation(fields: [paymentId], references: [paymentId])

  @@map("fabric_returns")
}

// --- Sales ---

model Sale {
  saleId           Int              @id @default(autoincrement()) @map("sale_id")
  fabricVariantId  Int?             @map("fabric_variant_id")
  yarnVariantId    Int?             @map("yarn_variant_id")
  merchantId       Int?             @map("merchant_id")
  weaverId         Int?             @map("weaver_id")
  movementType     SaleMovementType @map("movement_type")
  quantity         Decimal          @db.Decimal(10, 2)
  unitPrice        Decimal          @map("unit_price") @db.Decimal(12, 2)
  saleDate         DateTime         @default(now()) @map("sale_date") @db.Timestamptz
  recordedByUserId Int              @map("recorded_by_user_id")
  paymentId        Int?             @map("payment_id")
  notes            String?

  fabricVariant FabricVariant? @relation(fields: [fabricVariantId], references: [fabricVariantId])
  yarnVariant   YarnVariant?   @relation(fields: [yarnVariantId], references: [yarnVariantId])
  merchant      Merchant?      @relation(fields: [merchantId], references: [merchantId])
  weaver        Weaver?        @relation(fields: [weaverId], references: [weaverId])
  recordedBy    User           @relation("SaleRecorder", fields: [recordedByUserId], references: [userId])
  payment       Payment?       @relation(fields: [paymentId], references: [paymentId])

  @@map("sales")
}

// --- Finance ---

model Payment {
  paymentId        Int      @id @default(autoincrement()) @map("payment_id")
  weaverId         Int      @map("weaver_id")
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String?  @map("payment_method") @db.VarChar(30)
  paymentDate      DateTime @default(now()) @map("payment_date") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  notes            String?

  weaver        Weaver         @relation(fields: [weaverId], references: [weaverId])
  recordedBy    User           @relation("PaymentRecorder", fields: [recordedByUserId], references: [userId])
  fabricReturns FabricReturn[]
  yarnGiven     YarnGiven[]
  sales         Sale[]
  commercialTransaction CommercialTransaction?
  settlementPreviewId String? @map("settlement_preview_id") @db.VarChar(24)
  settlementPreview   SettlementPreview? @relation(fields: [settlementPreviewId], references: [previewId])

  @@map("payments")
}

model MerchantPayment {
  paymentId        Int      @id @default(autoincrement()) @map("payment_id")
  merchantId       Int      @map("merchant_id")
  amount           Decimal  @db.Decimal(12, 2)
  paymentMethod    String?  @map("payment_method") @db.VarChar(30)
  paymentDate      DateTime @default(now()) @map("payment_date") @db.Timestamptz
  recordedByUserId Int      @map("recorded_by_user_id")
  notes            String?

  merchant   Merchant @relation(fields: [merchantId], references: [merchantId])
  recordedBy User   @relation("MerchantPaymentRecorder", fields: [recordedByUserId], references: [userId])

  @@map("merchant_payments")
}

// --- Commercial transactions ---

model CommercialTransaction {
  transactionId    String              @id @map("transaction_id") @db.VarChar(24)
  type             CommercialTxnType
  status           CommercialTxnStatus @default(pending)
  paymentTerms     PaymentTerms        @map("payment_terms")
  supplierId       Int?                @map("supplier_id")
  weaverId         Int?                @map("weaver_id")
  merchantId       Int?                @map("merchant_id")
  totalAmount      Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  amountPaid       Decimal             @default(0) @map("amount_paid") @db.Decimal(14, 2)
  deliveredAt      DateTime?           @map("delivered_at") @db.Timestamptz
  notes            String?
  linkedPaymentId  Int?                @unique @map("linked_payment_id")
  createdByUserId  Int                 @map("created_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  supplier      Supplier? @relation(fields: [supplierId], references: [supplierId])
  weaver        Weaver?   @relation(fields: [weaverId], references: [weaverId])
  merchant      Merchant? @relation(fields: [merchantId], references: [merchantId])
  linkedPayment Payment?  @relation(fields: [linkedPaymentId], references: [paymentId])
  createdBy     User      @relation("CommercialTxnCreator", fields: [createdByUserId], references: [userId])
  lines         CommercialTransactionLine[]
  payments      CommercialTransactionPayment[]

  @@map("commercial_transactions")
}

model CommercialTransactionLine {
  lineId            Int     @id @default(autoincrement()) @map("line_id")
  transactionId     String  @map("transaction_id") @db.VarChar(24)
  yarnVariantId     Int?    @map("yarn_variant_id")
  fabricVariantId   Int?    @map("fabric_variant_id")
  yarnTypeId        Int?    @map("yarn_type_id")
  colorId           Int?    @map("color_id")
  supplierId        Int?    @map("supplier_id")
  productId         Int?    @map("product_id")
  warpColorId       Int?    @map("warp_color_id")
  weftColorId       Int?    @map("weft_color_id")
  designId          Int?    @map("design_id")
  quantity          Decimal @db.Decimal(10, 2)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  deliveredQuantity Decimal @default(0) @map("delivered_quantity") @db.Decimal(10, 2)
  description       String? @db.VarChar(200)

  transaction   CommercialTransaction @relation(fields: [transactionId], references: [transactionId])
  yarnVariant   YarnVariant?          @relation(fields: [yarnVariantId], references: [yarnVariantId])
  fabricVariant FabricVariant?        @relation(fields: [fabricVariantId], references: [fabricVariantId])

  @@map("commercial_transaction_lines")
}

model CommercialTransactionPayment {
  installmentId    Int      @id @default(autoincrement()) @map("installment_id")
  transactionId    String   @map("transaction_id") @db.VarChar(24)
  amount           Decimal  @db.Decimal(12, 2)
  paymentDate      DateTime @default(now()) @map("payment_date") @db.Timestamptz
  paymentMethod    String?  @map("payment_method") @db.VarChar(30)
  notes            String?
  recordedByUserId Int      @map("recorded_by_user_id")

  transaction CommercialTransaction @relation(fields: [transactionId], references: [transactionId])
  recordedBy  User                  @relation("CommercialTxnPaymentRecorder", fields: [recordedByUserId], references: [userId])

  @@map("commercial_transaction_payments")
}

model SettlementPreview {
  previewId         String                  @id @map("preview_id") @db.VarChar(24)
  status            SettlementPreviewStatus @default(draft)
  snapshot          Json
  createdByUserId   Int                     @map("created_by_user_id")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  committedAt       DateTime?               @map("committed_at") @db.Timestamptz

  createdBy User      @relation("SettlementPreviewCreator", fields: [createdByUserId], references: [userId])
  payments  Payment[]

  @@map("settlement_previews")
}