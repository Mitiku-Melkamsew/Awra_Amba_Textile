# Database
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/awra_amba_textile?schema=public"

# JWT – generate a strong random secret (min 64 chars) for production
JWT_SECRET="CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"

# Server
PORT=3001
NODE_ENV="production"
# Number of reverse-proxy hops to trust for client IP detection (rate limiting).
# Use 1 behind Nginx/ALB, 0 if the API is exposed directly.
TRUST_PROXY="1"

# CORS – comma-separated list of allowed frontend origins
CORS_ORIGIN="https://your-production-domain.com"
